# Copy to .env.local and fill in. .env.local is git-ignored.

# Where data comes from: "mock" (fake in-memory data) or "supabase" (not built yet).
DATA_SOURCE=mock

# Supabase (needed once DATA_SOURCE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only admin key. Never prefix with NEXT_PUBLIC_ and never use it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Signs session cookies. Required in production; any long random string.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Where photo uploads are saved while using fake data (default: .data/uploads)
# UPLOAD_DIR=.data/uploads

# Email (inquiries). Without RESEND_API_KEY, emails are printed in the terminal instead.
# Get a key at https://resend.com. EMAIL_FROM must use a domain verified in Resend.
# RESEND_API_KEY=
# EMAIL_FROM=subBruinLease <hello@yourdomain.com>
# Base URL used for links inside emails (default: http://localhost:3000)
# APP_URL=http://localhost:3000
